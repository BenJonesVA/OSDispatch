# Host port nginx publishes (the app itself is not published directly).
HTTP_PORT=3331

# Postgres
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dispatch_tracker

# express-session signing secret — set to a long random string in real use.
SESSION_SECRET=change-me-too

# Display units for the dispatch dashboard: metric or imperial.
# Distance/speed are always computed and stored in km / km/h regardless of this setting.
UNITS=metric

# Best-effort speed-limit lookup (OpenStreetMap via the public Overpass API)
# recorded alongside each ping. Set to false to disable entirely (e.g. no
# outbound internet access from the app container).
SPEED_LIMIT_LOOKUP=true
